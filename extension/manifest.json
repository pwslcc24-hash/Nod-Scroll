{
  "manifest_version": 3,
  "name": "Nod Scroll — Hands-Free Short Video",
  "version": "1.6.5",
  "description": "Navigate Facebook Reels, YouTube Shorts, TikTok, and Instagram Reels with head nods. Camera processing stays on-device.",
  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://nod-scroll.netlify.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/reel/*",
        "https://www.facebook.com/reels/*",
        "https://www.youtube.com/shorts/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/reels/*",
        "https://www.instagram.com/reel/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "main.js",
        "vendor/vision_bundle.mjs",
        "vendor/wasm/*",
        "vendor/face_landmarker.task"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*"
      ]
    }
  ]
}
